# ============================================================

# HAMBACKEND - Git Ignore

# ============================================================

# ------------------------------------------------------------

# Environment variables & secrets

# ------------------------------------------------------------

.env
.env.*
!.env.example

*.pem
*.key
*.crt
*.p12
*.pfx
*.jks

# Secret/config files that may contain credentials

secrets/
secret/
credentials/
*.secret
*.credentials

# ------------------------------------------------------------

# Python

# ------------------------------------------------------------

**pycache**/
*.py[cod]
*$py.class

*.so

# Python build / packaging

build/
dist/
*.egg-info/
.eggs/

# Distribution metadata

pip-wheel-metadata/

# Coverage

.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/

# Type checking

.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# Profiling

.prof
*.prof

# Jupyter

.ipynb_checkpoints/

# ------------------------------------------------------------

# Virtual environments

# ------------------------------------------------------------

.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------

# Django

# ------------------------------------------------------------

# Local database

db.sqlite3
db.sqlite3-journal

# Django generated files

*.log

# Static/media files generated locally

staticfiles/
media/

# Local Django settings

local_settings.py

# ------------------------------------------------------------

# Celery

# ------------------------------------------------------------

celerybeat-schedule
celerybeat-schedule.db
celerybeat.pid

# ------------------------------------------------------------

# Redis

# ------------------------------------------------------------

dump.rdb
appendonly.aof

# Redis local data directories

redis-data/
redis/

# ------------------------------------------------------------

# Docker

# ------------------------------------------------------------

# Docker local volumes / persistent data

docker-data/
docker-volumes/

# Docker override files are normally developer-specific

docker-compose.override.yml
docker-compose.local.yml

# Docker logs

docker-logs/
*.docker.log

# ------------------------------------------------------------

# VictoriaMetrics

# ------------------------------------------------------------

# Never commit actual time-series database data

victoriametrics-data/
victoria-metrics-data/

# If mounted as a local directory

victoriametrics/data/
victoria-metrics/data/

# VM temporary files

*.vmcache
*.vmdelta
*.vmbackup

# Local VM logs

victoriametrics/*.log

# ------------------------------------------------------------

# vmagent

# ------------------------------------------------------------

# Local vmagent data/cache

vmagent-data/
vmagent/data/

# vmagent temporary files

vmagent/*.log

# ------------------------------------------------------------

# vmauth

# ------------------------------------------------------------

# Local vmauth data/cache

vmauth-data/
vmauth/data/

# Never commit local auth/config containing credentials

vmauth/*.secret
vmauth/*.credentials

# ------------------------------------------------------------

# Grafana

# ------------------------------------------------------------

# Grafana persistent database/data

grafana-data/
grafana/data/

# Grafana local database

grafana.db

# Grafana logs

grafana/logs/
grafana/*.log

# Grafana plugins installed locally

grafana/plugins/

